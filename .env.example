# Supabase (frontend-safe publishable key; legacy anon key is accepted too)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional legacy alias supported by the app:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Direct OpenAI API (primary multimodal AI provider; billed separately from ChatGPT)
OPENAI_API_KEY=
OPENAI_RECEIPT_MODEL=gpt-5.6-sol
OPENAI_RECEIPT_FALLBACK_MODEL=gpt-5.6-luna
OPENAI_RECEIPT_ARBITER_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=high
OPENAI_RECEIPT_MAX_OUTPUT_TOKENS=1800
OPENAI_INSIGHTS_MODEL=gpt-5.6-luna
OPENAI_INSIGHTS_FALLBACK_MODEL=gpt-5.6-luna
OPENAI_INSIGHTS_REASONING=low
OPENAI_INSIGHTS_MAX_OUTPUT_TOKENS=700
OPENAI_TIMEOUT_MS=60000

# Emergent fallback (used only when direct OpenAI is unavailable or fails)
EMERGENT_LLM_KEY=
EMERGENT_RECEIPT_LLM_PROVIDER=openai
EMERGENT_RECEIPT_LLM_MODEL=gpt-4o
EMERGENT_RECEIPT_LLM_FALLBACK_MODEL=gpt-4o-mini
EMERGENT_INSIGHTS_LLM_PROVIDER=openai
EMERGENT_INSIGHTS_LLM_MODEL=gpt-4o-mini
EMERGENT_INSIGHTS_LLM_FALLBACK_MODEL=gpt-4o-mini

# Receipt OCR corroboration (recommended alongside OpenAI vision)
OCR_MODE=live
OCR_PROVIDER=ocrspace
OCR_API_KEY=

# CORS (optional)
CORS_ORIGINS=*

# Demo only: set OCR_MODE=demo explicitly when you intentionally want canned sample OCR.
# NOTE: RupeeRizz does not require a Supabase service-role/secret key in this app.
