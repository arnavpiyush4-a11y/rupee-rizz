# Required for Supabase authentication/data in the existing RupeeRizz app.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
# Legacy name is also supported by the existing app:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Required for live Earn Radar Search + Fetch (server-side only; never NEXT_PUBLIC_).
TINYFISH_API_KEY=your_tinyfish_api_key_here

# Optional existing integrations (configure only when you use them).
OPENAI_API_KEY=your_openai_api_key_here
OCR_MODE=live
OCR_PROVIDER=ocrspace
OCR_API_KEY=your_ocrspace_api_key_here
# EMERGENT_LLM_KEY=your_emergent_llm_key_here
