# Required for Supabase authentication/data in the existing RupeeRizz app.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
# Legacy name is also supported by the existing app:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Required for live Earn Radar Search + Fetch (server-side only; never NEXT_PUBLIC_).
TINYFISH_API_KEY=your_tinyfish_api_key_here

# Local OCR signs image-bound scan results. Generate a private value with openssl rand -hex 32.
RR_OCR_SIGNING_KEY=
# Optional OCR overrides. English automatically uses models/ocr/best when installed.
# RR_OCR_EXECUTABLE=tesseract
# RR_OCR_TESSDATA_DIR=/absolute/path/to/validated-models
# RR_OCR_LANG_EN=eng
# RR_OCR_LANG_HI=eng+hin
# RR_OCR_LANG_OR=ori+eng
# Optional existing financial insight integration only.
# OPENAI_API_KEY=
